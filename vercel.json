{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "usaavoting.com" }],
      "destination": "/maintenance.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.usaavoting.com" }],
      "destination": "/public/maintenance.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}